NODE_ENV=development
PORT=8081

# PostgreSQL. Local Docker default is shown here. On Render, use the Supabase
# transaction-pooler URL and set PGSSLMODE=require.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55433/vyparhub
PGSSLMODE=

# Customer-facing JWTs used by Flutter REST auth and the /customer socket namespace.
JWT_ACCESS_SECRET=replace-with-long-random-customer-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-customer-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=365d

# Admin-only JWTs used by admin REST auth and the /admin socket namespace.
# These must be different from the customer JWT secrets.
ADMIN_JWT_ACCESS_SECRET=replace-with-long-random-admin-access-secret
ADMIN_JWT_REFRESH_SECRET=replace-with-long-random-admin-refresh-secret
ADMIN_JWT_ACCESS_EXPIRES=15m
ADMIN_JWT_REFRESH_EXPIRES=7d

# Comma-separated origins allowed by REST CORS and Socket.io.
# Use * only for temporary local testing.
CORS_ORIGIN=http://localhost:8082,http://192.168.1.109:8082

# Store timezone used for dashboard Today/Week/Month buckets.
STORE_TIMEZONE=Asia/Kolkata

# Firebase Admin. Prefer FIREBASE_SERVICE_ACCOUNT_JSON on Render, pasted as the
# full service-account JSON value. Keep FIREBASE_SERVICE_ACCOUNT_PATH for local dev.
FCM_SERVER_KEY=replace-with-firebase-server-key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-admin-client-email
FIREBASE_PRIVATE_KEY="replace-with-firebase-admin-private-key"

# Razorpay. Keep placeholders until payments are activated.
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# OTP. Mock/dev bypass must stay disabled in production.
OTP_PROVIDER=msg91
OTP_CODE_TTL_MINUTES=10
OTP_DEV_CODE=123456
ALLOW_DEV_OTP_BYPASS=false
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_TEMPLATE_ID=replace-with-msg91-template-id
MSG91_SENDER_ID=VYPRHB

# Public URLs used by docs/admin helpers.
PUBLIC_API_BASE_URL=
PUBLIC_BASE_URL=https://vyparhub.onrender.com

# Persistent image uploads. Required in production because Render disk is ephemeral.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vyparhub-assets

# Smoke test config. Defaults target local server and demo admin credentials.
SMOKE_API_BASE_URL=http://localhost:8081/api
SMOKE_SOCKET_ORIGIN=http://localhost:8081
SMOKE_ADMIN_EMAIL=admin@vyparhub.com
SMOKE_ADMIN_PASSWORD=Admin@123
SMOKE_CUSTOMER_PHONE=
SMOKE_CUSTOMER_PASSWORD=Demo@123
